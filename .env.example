# ASI:One API key: https://asi1.ai (log in -> Developer section -> Create New)
ASI1_API_KEY=your-asi1-api-key

# Private seeds: each one fixes an agent's address. Use long random strings
# and never commit real values.
KAGAZ_COORDINATOR_SEED=change-me-coordinator-long-random-string
KAGAZ_READER_SEED=change-me-reader-long-random-string
KAGAZ_VERIFY_SEED=change-me-verify-long-random-string
KAGAZ_RULES_SEED=change-me-rules-long-random-string
KAGAZ_ACTION_SEED=change-me-action-long-random-string
KAGAZ_EXPERT_SEED=change-me-expert-long-random-string

# true = connect to Agentverse mailbox (needed for ASI:One)
KAGAZ_USE_MAILBOX=true
# true = live domain-age lookups in the Verify agent
KAGAZ_ONLINE_CHECKS=true

# Expert review pricing
KAGAZ_EXPERT_FEE=0.5
KAGAZ_EXPERT_CURRENCY=FET
KAGAZ_EXPERT_FEE_INR=99
# true = real testnet FET transfer (fund the coordinator wallet first)
KAGAZ_REAL_FET=false

# Optional: real card/UPI payments for the Rs 99 review (Stripe test keys work).
# Leave empty to run in labelled demo mode. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=inr

# Optional: expert marketplace
# Comma-separated agent addresses of human experts you have checked on the ICAI / Bar Council register
KAGAZ_VERIFIED_EXPERTS=
# Seconds a human expert has to pick up a job before it moves on (AI desk as the last fallback)
KAGAZ_EXPERT_ACCEPT_SECONDS=120
# Kagaz's share of each paid review, in percent
KAGAZ_PLATFORM_FEE_PERCENT=20

# Each specialist agent can also be used on its own from ASI:One. With this key
# (agentverse.ai -> Profile -> API Keys) every agent creates its own Agentverse
# mailbox and profile on start. Leave empty to connect them by hand.
AGENTVERSE_API_KEY=
KAGAZ_SPECIALIST_MAILBOX=true
